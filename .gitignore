# ---------------------------------------------------------------
# IDEs
# ---------------------------------------------------------------
# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# VS Code: ignore personal settings but keep shared launch/task configs
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json

# ---------------------------------------------------------------
# Flutter / Dart / Pub
# ---------------------------------------------------------------
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
/build/
/coverage/
.widget_preview/

# Flutter version manager
.fvm/flutter_sdk
.fvmrc.local

# Symbolication / obfuscation output
app.*.symbols
app.*.map.json

# ---------------------------------------------------------------
# Android
# ---------------------------------------------------------------
/android/app/debug
/android/app/profile
/android/app/release
/android/.gradle
/android/.kotlin
/android/local.properties
/android/captures/
**/android/**/GeneratedPluginRegistrant.java

