**/GeneratedPluginRegistrant.*

# ---------------------------------------------------------------
# Secrets & signing — never commit these
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.keystore
*.jks
key.properties
*.p12
*.p8
*.mobileprovision
*.pem

# Firebase config files (uncomment if you add Firebase and keep the
# repo public; otherwise these are usually safe to commit)
# android/app/google-services.json
# ios/Runner/GoogleService-Info.plist
# macos/Runner/GoogleService-Info.plist
# lib/firebase_options.dart
